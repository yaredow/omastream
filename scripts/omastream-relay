#!/usr/bin/env python3
import sys
import os
import subprocess
import tempfile
import shutil
import threading
import signal
from urllib.parse import parse_qs, urlparse
from http.server import HTTPServer, BaseHTTPRequestHandler

def cookie_args():
    script_dir = os.path.dirname(os.path.abspath(__file__))
    detect_path = os.path.join(script_dir, "detect-browser.sh")
    if not os.access(detect_path, os.X_OK):
        return []
    try:
        browser = subprocess.check_output([detect_path], text=True).strip()
    except subprocess.CalledProcessError:
        return []
    if not browser:
        return []
    return ["--cookies-from-browser", browser]

def yt_env():
    env = os.environ.copy()
    if env.get("XDG_CURRENT_DESKTOP", "") in ("Hyprland", "omarchy", ""):
        env["XDG_CURRENT_DESKTOP"] = "GNOME"
    return env

def yt_base_cmd():
    return [
        "yt-dlp",
        "--no-warnings",
        "--no-playlist",
        *cookie_args(),
    ]

def resolve_format_ids(url: str, format_selector: str) -> list[str]:
    cmd = yt_base_cmd() + [
        "--print",
        "%(format_id)s",
        "-f",
        format_selector,
        url,
    ]
    try:
        raw = subprocess.check_output(cmd, text=True, env=yt_env()).strip()
    except subprocess.CalledProcessError as exc:
        print(f"ERROR resolving formats: {exc}", file=sys.stderr)
        return []

    lines = [line.strip() for line in raw.splitlines() if line.strip()]
    if not lines:
        return []

    if len(lines) == 1 and "+" in lines[0]:
        return [part for part in lines[0].split("+") if part]

    return lines

def terminate_process(proc: subprocess.Popen | None):
    if proc is None or proc.poll() is not None:
        return
    try:
        proc.terminate()
        proc.wait(timeout=2)
    except Exception:
        try:
            proc.kill()
        except Exception:
            pass

class StreamingHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        return

    def do_GET(self):
        format_ids = list(self.server.format_ids)
        yt_url = self.server.yt_url
        if not format_ids:
            self.send_response(500)
            self.end_headers()
            return

        query = parse_qs(urlparse(self.path).query)
        try:
            start_sec = float((query.get("t") or ["0"])[0])
        except (TypeError, ValueError):
            start_sec = 0.0
        if start_sec < 0:
            start_sec = 0.0

        self.send_response(200)
        self.send_header("Content-Type", "video/mp2t")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

        self._stream_ytdlp_sections(yt_url, format_ids, start_sec)

    def _stream_ytdlp_sections(self, yt_url: str, format_ids: list[str], start_sec: float):
        # We must multiplex the streams. Since ffmpeg HTTP gets 403 without headers/cookies,
        # we will use yt-dlp to download the sections into pipes and use ffmpeg to mux.
        # But ffmpeg cannot seek on a pipe! So yt-dlp MUST download exactly the section we need.
        tmpdir = tempfile.mkdtemp(prefix="omastream-relay-")
        procs: list[subprocess.Popen] = []
        try:
            if len(format_ids) == 1:
                cmd = yt_base_cmd()
                if start_sec > 0.05:
                    cmd.extend(["--download-sections", f"*{int(start_sec)}-inf"])
                cmd.extend(["-f", format_ids[0], "-o", "-", "--no-part", yt_url])
                
                proc = subprocess.Popen(
                    cmd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    env=yt_env(),
                )
                procs.append(proc)

                ffmpeg_cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-i", "pipe:0", "-c", "copy", "-f", "mpegts", "pipe:1"]

                ffmpeg = subprocess.Popen(
                    ffmpeg_cmd,
                    stdin=proc.stdout,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                )
                procs.append(ffmpeg)
                
                self._pump(ffmpeg.stdout)
                return

            v_fifo = os.path.join(tmpdir, "video.fifo")
            a_fifo = os.path.join(tmpdir, "audio.fifo")
            os.mkfifo(v_fifo)
            os.mkfifo(a_fifo)

            ffmpeg_cmd = [
                "ffmpeg",
                "-hide_banner",
                "-loglevel",
                "error",
                "-i",
                v_fifo,
                "-i",
                a_fifo,
                "-c",
                "copy",
                "-f",
                "mpegts",
                "pipe:1",
            ]

            ffmpeg = subprocess.Popen(
                ffmpeg_cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
            )
            procs.append(ffmpeg)

            def start_downloader(fmt: str, path: str):
                cmd = yt_base_cmd()
                if start_sec > 0.05:
                    cmd.extend(["--download-sections", f"*{int(start_sec)}-inf"])
                cmd.extend(["-f", fmt, "-o", path, "--no-part", yt_url])
                
                proc = subprocess.Popen(
                    cmd,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    env=yt_env(),
                )
                procs.append(proc)

            start_downloader(format_ids[0], v_fifo)
            start_downloader(format_ids[1], a_fifo)
            self._pump(ffmpeg.stdout)
        except Exception as exc:
            pass
        finally:
            for proc in procs:
                terminate_process(proc)
            shutil.rmtree(tmpdir, ignore_errors=True)

    def _pump(self, stream):
        try:
            while True:
                chunk = stream.read(65536)
                if not chunk:
                    break
                self.wfile.write(chunk)
        except Exception:
            pass

def main():
    if len(sys.argv) < 3:
        print("usage: omastream-relay <youtube-url> <format-selector> [start-seconds]", file=sys.stderr)
        sys.exit(1)

    yt_url = sys.argv[1]
    yt_format = sys.argv[2]
    initial_start = 0.0
    if len(sys.argv) >= 4:
        try:
            initial_start = max(0.0, float(sys.argv[3]))
        except ValueError:
            initial_start = 0.0

    format_ids = resolve_format_ids(yt_url, yt_format)
    if not format_ids:
        print("Failed to resolve adaptive formats for relay.", file=sys.stderr)
        sys.exit(1)

    server = HTTPServer(("127.0.0.1", 0), StreamingHandler)
    server.yt_url = yt_url
    server.yt_format = yt_format
    server.format_ids = format_ids
    server.initial_start = initial_start

    port = server.server_port
    if initial_start > 0.05:
        print(f"http://127.0.0.1:{port}/?t={initial_start:.3f}", flush=True)
    else:
        print(f"http://127.0.0.1:{port}/", flush=True)

    def _stop(*_args):
        threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    try:
        server.serve_forever()
    finally:
        server.server_close()

if __name__ == "__main__":
    main()
