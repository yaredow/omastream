{
  "schemaVersion": 1,
  "id": "user.omastream",
  "name": "omaStream",
  "version": "0.1.0",
  "author": "yada",
  "license": "MIT",
  "description": "Quickshell video & audio search and player plugin for Omarchy",
  "kinds": [
    "service",
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "PlaybackService.qml",
    "overlay": "OmaStreamOverlay.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "omaStream",
    "description": "Open omaStream video search & player",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
