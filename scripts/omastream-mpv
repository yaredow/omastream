#!/usr/bin/env bash
# omaStream helper script to launch mpv player with YouTube URLs

VIDEO_INPUT="$1"

if [ -z "$VIDEO_INPUT" ]; then
    echo "Usage: omastream-mpv <video-url-or-id>"
    exit 1
fi

# Build standard YouTube URL if video ID was provided
if [[ "$VIDEO_INPUT" =~ ^[A-Za-z0-9_-]{11}$ ]]; then
    FULL_URL="https://www.youtube.com/watch?v=${VIDEO_INPUT}"
else
    FULL_URL="$VIDEO_INPUT"
fi

exec mpv --force-window=immediate --ytdl-format="bestvideo[height<=1080]+bestaudio/best" "$FULL_URL"
